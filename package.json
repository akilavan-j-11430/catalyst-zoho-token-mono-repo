{
  "name": "catalyst-zoho-token-mono-repo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/dev.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "verify": "turbo run build lint typecheck test:unit test:integration",
    "bundle": "turbo run bundle",
    "spawn:proxy": "turbo run bundle --filter=proxy && catalyst serve --only appsail:proxy",
    "deploy": "turbo run bundle && catalyst deploy --only slate:web"
  },
  "packageManager": "pnpm@10.28.1",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@zcatalyst/auth": "^1.0.0",
    "@zcatalyst/cache": "^1.0.0",
    "@zcatalyst/datastore": "^1.0.0",
    "@zcatalyst/job-scheduling": "^1.0.0",
    "@zcatalyst/stratus": "^1.0.0",
    "esbuild": "^0.28.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.6"
  }
}
