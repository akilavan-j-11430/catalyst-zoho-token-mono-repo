# Read by apps/web at build time, and only in the deployed build. Never staged for Slate.

# The AppSail origin the browser calls, e.g. https://api-<ZAID>.development.catalystappsail.com
# Set it in Console -> Slate -> web -> Environment Variables. Leave it unset locally, so
# calls stay relative and go through apps/proxy.
NEXT_PUBLIC_API_URL=
