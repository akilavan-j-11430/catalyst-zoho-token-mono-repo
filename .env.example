# Shared across every app. App-specific values live in apps/<app>/.env

X_ZOHO_CATALYST_IS_LOCAL=
X_ZOHO_CATALYST_ACCOUNTS_URL=
X_ZOHO_CATALYST_CONSOLE_URL=
X_ZOHO_STRATUS_RESOURCE_SUFFIX=
CATALYST_PORTAL_DOMAIN=

# Read by apps/api. Declared on its template in apps/api/src/env.ts.

# Where Catalyst sends a new user from the confirmation email. Locally this is the
# origin `catalyst serve` prints, usually http://localhost:3001/
AUTH_REDIRECT_URL=

# Optional. Timezone for log timestamps. Defaults to Asia/Kolkata.
TZ=
