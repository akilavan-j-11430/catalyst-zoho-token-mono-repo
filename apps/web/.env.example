# Read by the server at request time. Never staged for Slate: deployed values are set in
# Console -> Slate -> web -> Environment Variables. README "3. Fill in the environment" says
# what goes in each one.

# Timezone for log timestamps, e.g. Asia/Kolkata. Optional.
TZ=

# Read by the Catalyst SDK, not by this app's code. Run `pnpm serve` once and paste the five
# lines the proxy prints in place of these - `catalyst serve` works them out from the project
# you signed in to. Paste all five, US included. On Slate set all but IS_LOCAL.
X_ZOHO_CATALYST_IS_LOCAL=
X_ZOHO_CATALYST_ACCOUNTS_URL=
X_ZOHO_CATALYST_CONSOLE_URL=
CATALYST_PORTAL_DOMAIN=
X_ZOHO_STRATUS_RESOURCE_SUFFIX=
