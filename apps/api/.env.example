# Read by apps/api. Every key is declared on its template in src/env.ts.
# Copy to apps/api/.env - gitignored - and fill in the values.

# Where Catalyst sends a new user from the confirmation email. Locally this is the
# origin `catalyst serve` prints, usually http://localhost:3001/
AUTH_REDIRECT_URL=

# Optional. Timezone for log timestamps. Defaults to Asia/Kolkata.
TZ=

# Zoho OAuth. The client is a Server-based client from https://api-console.zoho.com

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Comma-separated, e.g. ZohoCRM.modules.ALL,ZohoCRM.settings.READ
ZOHO_SCOPES=

# The DC's accounts server, scheme and all, e.g. https://accounts.zoho.in - it is handed
# to HttpClient unchanged, which rejects a value it cannot parse as an absolute url
ZOHO_ACCOUNTS_URL=

# Optional. The domain the app is served from, e.g. localhost:3001. A scheme is allowed and
# kept; without one it is http for localhost and https otherwise. Set it locally, where the
# api only sees the proxy's host; when unset it is taken from the request. The Zoho
# client's Authorized Redirect URI must be that origin plus /api/zoho-token/callback
WEB_ORIGIN=
