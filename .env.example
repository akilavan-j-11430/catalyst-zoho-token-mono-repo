# Shared across every app. App-specific values live in apps/<app>/.env

X_ZOHO_CATALYST_IS_LOCAL=
X_ZOHO_CATALYST_ACCOUNTS_URL=
X_ZOHO_CATALYST_CONSOLE_URL=
X_ZOHO_STRATUS_RESOURCE_SUFFIX=
CATALYST_PORTAL_DOMAIN=

# Read by apps/api. Declared on its template in apps/api/src/env.ts.

# Where Catalyst sends a new user from the confirmation email. Locally this is the
# origin `catalyst serve` prints, usually http://localhost:3001/
AUTH_REDIRECT_URL=

# Optional. Timezone for log timestamps. Defaults to Asia/Kolkata.
TZ=

# Zoho OAuth. The client is a Server-based client from https://api-console.zoho.com

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Comma-separated, e.g. ZohoCRM.modules.ALL,ZohoCRM.settings.READ
ZOHO_SCOPES=

# The DC's accounts server, scheme and all, e.g. https://accounts.zoho.in - it is handed
# to HttpClient unchanged, which rejects a value it cannot parse as an absolute url
ZOHO_ACCOUNTS_URL=

# The origin the app is served from, e.g. http://localhost:3001 locally. The Zoho client's
# Authorized Redirect URI must be this origin plus /api/zoho-token/callback
APP_ORIGIN=
