{
  "name": "@repo/http-server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "license": "ISC",
  "scripts": {
    "dev": "tsc --build tsconfig.build.json && concurrently -n tsc,alias \"tsc --build tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --watch\"",
    "build": "tsc --build tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test:unit": "vitest run --project unit"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.6",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@repo/node-utils": "workspace:*",
    "@repo/types": "workspace:*",
    "@zcatalyst/auth": "^1.0.0",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  }
}
